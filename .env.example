# ChordSet Environment Variables

# Basic Auth (required for public deployment)
BASIC_AUTH_USER=admin
BASIC_AUTH_PASSWORD=suaSenhaForte123

# Database path (default: ./data/chordset.db)
DATABASE_PATH=/data/chordset.db

# Audio upload storage path (default: ./data/audio in dev)
# In Docker/prod, point to the persistent volume: /data/audio
AUDIO_STORAGE_PATH=/data/audio

# LLM API Keys for Import via Photo feature
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...
OPENROUTER_API_KEY=sk-or-...
DATABASE_PATH=/data/chordset.db
